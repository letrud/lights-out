{
  "spec": 1,
  "title": "Foundry Control Room",
  "eyebrow": "Software factory · Fleet",
  "brandIcon": "factory",
  "liveLabel": "Control plane live",
  "syncLabel": "synced",
  "unit": {
    "singular": "component",
    "plural": "components",
    "id": "name",
    "label": "name",
    "subtitle": "path",
    "search": [
      "name",
      "path",
      "squad",
      "lang",
      "owner"
    ],
    "searchPlaceholder": "Search repo, squad, owner…",
    "accent": {
      "field": "lang",
      "palette": {
        "TypeScript": "#3178c6",
        "Go": "#00acd7",
        "Java": "#e76f00",
        "Python": "#3f7fbf",
        "Rust": "#c06a3f",
        "C#": "#6a3fa0",
        "Kotlin": "#a97bff"
      }
    },
    "group": {
      "field": "squad",
      "label": "Squad"
    },
    "class": {
      "field": "tier",
      "label": "Tier",
      "prefix": "T",
      "ranks": {
        "1": "crit",
        "2": "warn",
        "3": "idle"
      }
    }
  },
  "states": {
    "ok": "ok",
    "warn": "warn",
    "crit": "crit",
    "run": "active",
    "idle": "absent",
    "none": "absent"
  },
  "severityLabels": {
    "ok": "healthy",
    "warn": "needs attention",
    "crit": "blocked"
  },
  "slots": [
    "dev",
    "test",
    "stage",
    "prod"
  ],
  "dimensions": [
    {
      "id": "automation",
      "label": "Automation",
      "summary": {
        "field": "auto",
        "suffix": "%"
      },
      "render": {
        "type": "sequence",
        "field": "stages",
        "steps": [
          {
            "key": "build",
            "short": "bld",
            "label": "Build"
          },
          {
            "key": "test",
            "short": "tst",
            "label": "Test"
          },
          {
            "key": "scan",
            "short": "sec",
            "label": "Security scan"
          },
          {
            "key": "sign",
            "short": "sgn",
            "label": "Signing"
          },
          {
            "key": "release",
            "short": "rel",
            "label": "Release"
          },
          {
            "key": "deploy",
            "short": "dep",
            "label": "Deploy"
          }
        ],
        "stateNotes": {
          "ok": "passing",
          "run": "running now",
          "warn": "flaky / degraded",
          "crit": "failing — blocks promotion",
          "idle": "not configured"
        },
        "links": "stageLinks"
      },
      "details": [
        {
          "label": "Automation score",
          "field": "auto",
          "suffix": "%"
        },
        {
          "label": "Deploys (7 days)",
          "field": "deploys"
        },
        {
          "label": "Lead time to prod",
          "field": "lead",
          "mono": true
        },
        {
          "label": "Change failure rate",
          "field": "cfr",
          "suffix": "%"
        },
        {
          "label": "Time to restore",
          "field": "mttr",
          "mono": true
        },
        {
          "label": "Last deploy",
          "field": "lastDeploy"
        }
      ],
      "trend": {
        "field": "freq",
        "label": "Deploys per day · last 10 days"
      }
    },
    {
      "id": "quality",
      "label": "Quality",
      "summary": {
        "template": "{rating} · {debt} debt"
      },
      "render": {
        "type": "gauge",
        "verdict": {
          "field": "gate",
          "labels": {
            "pass": "Gate passed",
            "warn": "Gate warning",
            "fail": "Gate failed"
          },
          "roles": {
            "pass": "ok",
            "warn": "warn",
            "fail": "crit"
          }
        },
        "value": {
          "field": "cov",
          "label": "coverage",
          "suffix": "%",
          "target": 80
        },
        "counters": [
          {
            "field": "vuln.c",
            "suffix": "C",
            "role": "crit",
            "label": "open critical CVEs"
          },
          {
            "field": "vuln.h",
            "suffix": "H",
            "role": "warn",
            "label": "open high CVEs"
          }
        ]
      },
      "details": [
        {
          "label": "Maintainability rating",
          "field": "rating"
        },
        {
          "label": "Technical debt",
          "field": "debt",
          "mono": true
        },
        {
          "label": "Coverage trend",
          "field": "covTrend",
          "suffix": " pts this month"
        },
        {
          "label": "Medium CVEs",
          "field": "vuln.m"
        }
      ]
    },
    {
      "id": "environments",
      "label": "Environments",
      "summary": {
        "derived": "matrix"
      },
      "render": {
        "type": "matrix",
        "value": "env",
        "state": "envState",
        "reference": "last",
        "compare": "semver",
        "drift": {
          "distinctOver": 2,
          "staleAny": true
        }
      },
      "details": [
        {
          "label": "Owning squad",
          "field": "squad"
        },
        {
          "label": "Tech lead",
          "field": "owner"
        },
        {
          "label": "Last deploy",
          "field": "lastDeploy"
        }
      ]
    },
    {
      "id": "supply",
      "label": "Supply chain",
      "card": false,
      "render": {
        "type": "facts",
        "facts": [
          {
            "label": "SLSA",
            "field": "slsa",
            "prefix": "L",
            "good": 3,
            "warn": 2
          },
          {
            "label": "SBOM",
            "field": "sbom",
            "as": "bool"
          },
          {
            "label": "Signed",
            "field": "signed",
            "as": "bool"
          },
          {
            "label": "Outdated deps",
            "field": "outdated",
            "max": 5,
            "warnMax": 20
          }
        ]
      },
      "details": [
        {
          "label": "Language",
          "field": "lang"
        },
        {
          "label": "Owner",
          "field": "owner"
        },
        {
          "label": "Runbook",
          "field": "runbook"
        }
      ]
    }
  ],
  "severity": [
    {
      "role": "crit",
      "when": {
        "any": [
          {
            "field": "gate",
            "eq": "fail"
          },
          {
            "field": "vuln.c",
            "gt": 0
          },
          {
            "anyOf": "stages",
            "eq": "crit"
          }
        ]
      }
    },
    {
      "role": "warn",
      "when": {
        "any": [
          {
            "field": "gate",
            "eq": "warn"
          },
          {
            "field": "vuln.h",
            "gt": 0
          },
          {
            "anyOf": "stages",
            "eq": "warn"
          },
          {
            "flag": "drifted"
          }
        ]
      }
    }
  ],
  "card": {
    "footer": [
      {
        "label": "last deploy",
        "field": "lastDeploy"
      },
      {
        "label": "lead",
        "field": "lead"
      }
    ],
    "trend": "freq"
  },
  "band": [
    {
      "label": "Components",
      "agg": "count",
      "breakdown": "severity"
    },
    {
      "label": "Automation",
      "agg": "avg",
      "field": "auto",
      "suffix": "%",
      "sub": "golden-path steps wired across the fleet"
    },
    {
      "label": "Baseline met",
      "agg": "conformance",
      "suffix": "%",
      "sub": "of applicable requirements across the fleet"
    },
    {
      "label": "Quality gates",
      "agg": "countWhere",
      "when": {
        "field": "gate",
        "eq": "pass"
      },
      "of": "total",
      "sub": "passing against the 80% coverage gate"
    },
    {
      "label": "Version drift",
      "agg": "countWhere",
      "when": {
        "flag": "drifted"
      },
      "tone": "inverse",
      "sub": "3+ versions in flight, or an env behind prod"
    },
    {
      "label": "Deploys · 7d",
      "agg": "sum",
      "field": "deploys",
      "trend": "freq"
    }
  ],
  "filters": [
    {
      "id": "all",
      "label": "All"
    },
    {
      "id": "attention",
      "label": "Needs attention",
      "when": {
        "not": {
          "severity": "ok"
        }
      }
    },
    {
      "id": "golden",
      "label": "Golden path",
      "when": {
        "all": [
          {
            "field": "auto",
            "gte": 80
          },
          {
            "field": "gate",
            "eq": "pass"
          }
        ]
      }
    },
    {
      "id": "drift",
      "label": "Drifted",
      "when": {
        "flag": "drifted"
      }
    }
  ],
  "sorts": [
    {
      "id": "risk",
      "label": "risk first",
      "by": "severity",
      "then": "auto"
    },
    {
      "id": "name",
      "label": "name",
      "field": "name"
    },
    {
      "id": "auto",
      "label": "automation",
      "field": "auto",
      "dir": "desc"
    },
    {
      "id": "cov",
      "label": "coverage",
      "field": "cov",
      "dir": "desc"
    },
    {
      "id": "lead",
      "label": "lead time",
      "field": "leadM"
    },
    {
      "id": "deploys",
      "label": "deploy count",
      "field": "deploys",
      "dir": "desc"
    }
  ],
  "legend": [
    {
      "swatch": "ok",
      "label": "healthy"
    },
    {
      "swatch": "warn",
      "label": "needs attention"
    },
    {
      "swatch": "crit",
      "label": "blocked / failing gate"
    },
    {
      "swatch": "active",
      "label": "running now"
    },
    {
      "label": "↑ built, waiting to promote  ·  ⚠ behind production"
    },
    {
      "label": "bld · tst · sec · sgn · rel · dep = build, test, security scan, signing, release, deploy"
    }
  ],
  "views": [
    {
      "id": "overview",
      "type": "cards",
      "icon": "grid",
      "label": "Components",
      "title": "Component overview",
      "crumb": "Software factory · Fleet"
    },
    {
      "id": "pipelines",
      "type": "table",
      "icon": "flow",
      "label": "Pipelines",
      "title": "Delivery pipelines",
      "crumb": "Software factory · Automation",
      "panel": "Pipeline coverage",
      "note": "Every component's path from commit to production, stage by stage.",
      "columns": [
        {
          "label": "Component",
          "field": "name",
          "sub": "squad"
        },
        {
          "label": "Stages",
          "as": "sequence",
          "dimension": "automation",
          "width": 220
        },
        {
          "label": "Automated",
          "field": "auto",
          "as": "num",
          "suffix": "%"
        },
        {
          "label": "Lead time",
          "field": "lead",
          "as": "mono"
        },
        {
          "label": "Deploys 7d",
          "field": "deploys",
          "as": "num"
        },
        {
          "label": "Trend",
          "field": "freq",
          "as": "trend"
        },
        {
          "label": "Last deploy",
          "field": "lastDeploy",
          "as": "muted"
        }
      ]
    },
    {
      "id": "quality",
      "type": "table",
      "icon": "shield",
      "label": "Quality",
      "title": "Quality gates",
      "crumb": "Software factory · Engineering health",
      "panel": "Quality gates",
      "note": "Coverage target is 80% — the tick on each bar.",
      "columns": [
        {
          "label": "Component",
          "field": "name",
          "sub": "path"
        },
        {
          "label": "Gate",
          "field": "gate",
          "as": "verdict",
          "labels": {
            "pass": "pass",
            "warn": "warn",
            "fail": "fail"
          },
          "roles": {
            "pass": "ok",
            "warn": "warn",
            "fail": "crit"
          }
        },
        {
          "label": "Line coverage",
          "field": "cov",
          "as": "meter",
          "target": 80,
          "suffix": "%",
          "width": 150
        },
        {
          "label": "Rating",
          "field": "rating",
          "as": "rating"
        },
        {
          "label": "Debt",
          "field": "debt",
          "as": "mono"
        },
        {
          "label": "Open CVEs",
          "as": "counters",
          "counters": [
            {
              "field": "vuln.c",
              "suffix": "C",
              "role": "crit"
            },
            {
              "field": "vuln.h",
              "suffix": "H",
              "role": "warn"
            },
            {
              "field": "vuln.m",
              "suffix": "M"
            }
          ]
        },
        {
          "label": "Runbook",
          "field": "runbook",
          "as": "bool",
          "yes": "linked",
          "no": "missing"
        }
      ]
    },
    {
      "id": "envs",
      "type": "matrix",
      "icon": "layers",
      "label": "Environments",
      "title": "Environment matrix",
      "crumb": "Software factory · Promotion",
      "panel": "Promotion matrix",
      "note": "What version is actually running where. Amber marks an environment behind production.",
      "trailing": {
        "label": "Last deploy",
        "field": "lastDeploy",
        "as": "muted"
      }
    },
    {
      "id": "supply",
      "type": "table",
      "icon": "link",
      "label": "Supply chain",
      "title": "Supply chain assurance",
      "crumb": "Software factory · Provenance",
      "panel": "Build provenance",
      "note": "Target for tier 1 is SLSA L3 with a signed, attested artifact.",
      "columns": [
        {
          "label": "Component",
          "field": "name",
          "sub": "lang"
        },
        {
          "label": "SLSA",
          "field": "slsa",
          "as": "level",
          "prefix": "L",
          "good": 3,
          "warn": 2
        },
        {
          "label": "SBOM",
          "field": "sbom",
          "as": "bool"
        },
        {
          "label": "Signed",
          "field": "signed",
          "as": "bool"
        },
        {
          "label": "Outdated deps",
          "field": "outdated",
          "as": "num"
        },
        {
          "label": "Open CVEs",
          "as": "counters",
          "counters": [
            {
              "field": "vuln.c",
              "suffix": "C",
              "role": "crit"
            },
            {
              "field": "vuln.h",
              "suffix": "H",
              "role": "warn"
            }
          ]
        },
        {
          "label": "Owner",
          "field": "owner",
          "as": "muted"
        }
      ]
    },
    {
      "id": "baseline",
      "type": "conformance",
      "icon": "flag",
      "label": "Baseline",
      "title": "Golden path baseline",
      "crumb": "Software factory · Standards",
      "panel": "Conformance to the golden path baseline",
      "note": "Each column is a baseline requirement. ✕ is a required gap for that tier, ! advisory, · not applicable."
    }
  ],
  "standard": {
    "label": "Golden path baseline",
    "note": "What every component must meet for its criticality tier. Tier 1 is customer-facing or money-touching.",
    "requirements": [
      {
        "id": "stages",
        "short": "pipe",
        "label": "Delivery pipeline fully wired",
        "dimension": "automation",
        "remedy": "Wire the missing stages from the golden-path template",
        "classes": {
          "1": {
            "level": "required",
            "when": {
              "everyOf": "stages",
              "ne": "idle"
            }
          },
          "2": {
            "level": "required",
            "when": {
              "everyOf": "stages",
              "ne": "idle"
            }
          },
          "3": {
            "level": "advisory",
            "when": {
              "all": [
                {
                  "field": "stages.build",
                  "ne": "idle"
                },
                {
                  "field": "stages.test",
                  "ne": "idle"
                }
              ]
            }
          }
        }
      },
      {
        "id": "coverage",
        "short": "cov",
        "label": "Line coverage at or above the tier threshold",
        "dimension": "quality",
        "remedy": "Raise coverage before the gate can be enforced",
        "classes": {
          "1": {
            "level": "required",
            "when": {
              "field": "cov",
              "gte": 80
            }
          },
          "2": {
            "level": "required",
            "when": {
              "field": "cov",
              "gte": 70
            }
          },
          "3": {
            "level": "advisory",
            "when": {
              "field": "cov",
              "gte": 50
            }
          }
        }
      },
      {
        "id": "gate",
        "short": "gate",
        "label": "Quality gate not failing",
        "dimension": "quality",
        "remedy": "Fix the failing gate or agree a temporary exception",
        "classes": {
          "1": {
            "level": "required",
            "when": {
              "field": "gate",
              "ne": "fail"
            }
          },
          "2": {
            "level": "required",
            "when": {
              "field": "gate",
              "ne": "fail"
            }
          },
          "3": {
            "level": "advisory",
            "when": {
              "field": "gate",
              "ne": "fail"
            }
          }
        }
      },
      {
        "id": "critical-cves",
        "short": "cve",
        "label": "No open critical vulnerabilities",
        "dimension": "quality",
        "remedy": "Patch or accept the critical finding — it blocks promotion",
        "classes": {
          "*": {
            "level": "required",
            "when": {
              "field": "vuln.c",
              "eq": 0
            }
          }
        }
      },
      {
        "id": "high-cves",
        "short": "high",
        "label": "Open high vulnerabilities within tier allowance",
        "dimension": "quality",
        "remedy": "Bring high findings down to the tier allowance",
        "classes": {
          "1": {
            "level": "required",
            "when": {
              "field": "vuln.h",
              "eq": 0
            }
          },
          "2": {
            "level": "required",
            "when": {
              "field": "vuln.h",
              "lte": 2
            }
          },
          "3": {
            "level": "advisory",
            "when": {
              "field": "vuln.h",
              "lte": 5
            }
          }
        }
      },
      {
        "id": "signed",
        "short": "sign",
        "label": "Artifacts signed",
        "dimension": "supply",
        "remedy": "Add the signing step (cosign) to the release stage",
        "classes": {
          "1": {
            "level": "required",
            "when": {
              "field": "signed",
              "truthy": true
            }
          },
          "2": {
            "level": "required",
            "when": {
              "field": "signed",
              "truthy": true
            }
          }
        }
      },
      {
        "id": "sbom",
        "short": "sbom",
        "label": "SBOM published with each build",
        "dimension": "supply",
        "remedy": "Emit and publish an SBOM from the build stage",
        "classes": {
          "1": {
            "level": "required",
            "when": {
              "field": "sbom",
              "truthy": true
            }
          },
          "2": {
            "level": "required",
            "when": {
              "field": "sbom",
              "truthy": true
            }
          }
        }
      },
      {
        "id": "slsa",
        "short": "slsa",
        "label": "SLSA build level at or above the tier threshold",
        "dimension": "supply",
        "remedy": "Generate provenance attestation from a trusted builder",
        "classes": {
          "1": {
            "level": "required",
            "when": {
              "field": "slsa",
              "gte": 3
            }
          },
          "2": {
            "level": "required",
            "when": {
              "field": "slsa",
              "gte": 2
            }
          },
          "3": {
            "level": "advisory",
            "when": {
              "field": "slsa",
              "gte": 1
            }
          }
        }
      },
      {
        "id": "runbook",
        "short": "run",
        "label": "Operational runbook linked",
        "dimension": "quality",
        "remedy": "Link a runbook before the component is on call",
        "classes": {
          "1": {
            "level": "required",
            "when": {
              "field": "runbook",
              "truthy": true
            }
          },
          "2": {
            "level": "required",
            "when": {
              "field": "runbook",
              "truthy": true
            }
          }
        }
      },
      {
        "id": "envs-current",
        "short": "env",
        "label": "No environment behind production",
        "dimension": "environments",
        "remedy": "Promote or redeploy the stale environment",
        "classes": {
          "1": {
            "level": "required",
            "when": {
              "not": {
                "flag": "stale"
              }
            }
          },
          "2": {
            "level": "required",
            "when": {
              "not": {
                "flag": "stale"
              }
            }
          },
          "3": {
            "level": "advisory",
            "when": {
              "not": {
                "flag": "stale"
              }
            }
          }
        }
      },
      {
        "id": "lead",
        "short": "lead",
        "label": "Lead time to production within the tier target",
        "dimension": "automation",
        "remedy": "Shorten the path to production — usually a missing deploy stage",
        "classes": {
          "1": {
            "level": "required",
            "when": {
              "field": "leadM",
              "lt": 1440
            }
          },
          "2": {
            "level": "advisory",
            "when": {
              "field": "leadM",
              "lt": 4320
            }
          }
        }
      }
    ]
  }
}
